APP_NAME="Nexus Infra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de dados (PostgreSQL) ----
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=nexus
DB_USERNAME=nexus
DB_PASSWORD=

# ---- Sessão / cache / fila (Redis) ----
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Em produção (HTTPS) PÔR true: cookie de sessão só viaja em ligações seguras (evita roubo por MITM).
SESSION_SECURE_COOKIE=true

# Vigia de backups: pôr true EM PRODUÇÃO depois de instalar o cron do scripts/backup.sh
# (ver scripts/RESTAURO.md). Alerta ALTA se o último backup tiver mais de X horas.
ALERTAS_BACKUP_VIGIA=false
ALERTAS_BACKUP_MAX_HORAS=26

# Processo de validação das despesas: quem aprova (contas da app; admins podem sempre) e
# quem recebe os emails de submissão/decisão, além de quem criou a despesa.
DESPESAS_APROVADORES=pgouveia@nxs.pt
DESPESAS_NOTIFICAR=pgouveia@nxs.pt,financeiro@nxs.pt

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Object storage (MinIO / S3) para anexos ----
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=nexus
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- Email ----
# MAIL_MAILER: 'log' (dev, vai para o laravel.log) ou 'graph' (Microsoft Graph, produção).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responder@nexus.pt"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Microsoft Graph (mailer 'graph') — SÓ NOMES; valores/segredo apenas no .env do servidor ----
# Com MAIL_MAILER=graph, o from passa a ser a mailbox MS_GRAPH_SENDER (ex.: Suporte@nxs.pt).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=
# Calendário partilhado da agenda no M365 (Graph, precisa de Calendars.ReadWrite com consentimento
# de admin). Ligar só depois do consentimento; o nome é o do calendário criado na mailbox do sender.
MS_GRAPH_CALENDARIO_ATIVO=false
MS_GRAPH_CALENDARIO_AGENDA="Agenda Nexus Infra"

# ---- Integração ERP (sync read-only) ----
# driver: vazio (inativo) | fake (dados de teste) | sqlsrv (views read-only do ERP)
ERP_DRIVER=
ERP_DB_HOST=
ERP_DB_PORT=1433
ERP_DB_DATABASE=
ERP_DB_USERNAME=
ERP_DB_PASSWORD=
# Timeout (segundos) das queries ao ERP — um PHC lento aborta em vez de pendurar o sync.
ERP_DB_TIMEOUT=30
# Nota: o sync corre 3x/dia (08h/13h/19h) — agendado em routes/console.php, não via env.

# API de sincronização (/api/sync/…): chave partilhada para disparar os syncs de fora (botão no
# PHC, cron externo). Vazio = API desligada. Gerar: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
API_SYNC_CHAVE=

VITE_APP_NAME="${APP_NAME}"

# Portal da suite: a única entrada (login/recuperar/convites redirecionam para lá).
PORTAL_URL=https://infra.nexus-solutions.pt:9443/portal
# Verificação em duas etapas por email: true = código após a password; false = só password
# (decisão da suite — o portal é a porta de entrada). Os testes correm sempre com true.
MFA_ACTIVA=true
