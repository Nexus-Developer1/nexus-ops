APP_NAME="Nexus Ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de dados (PostgreSQL) ----
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=nexus
DB_USERNAME=nexus
DB_PASSWORD=

# ---- Sessão / cache / fila (Redis) ----
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ---- Object storage (MinIO / S3) para anexos ----
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=nexus
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# ---- Email ----
# MAIL_MAILER: 'log' (dev, vai para o laravel.log) ou 'graph' (Microsoft Graph, produção).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responder@nexus.pt"
MAIL_FROM_NAME="${APP_NAME}"

# ---- Microsoft Graph (mailer 'graph') — SÓ NOMES; valores/segredo apenas no .env do servidor ----
# Com MAIL_MAILER=graph, o from passa a ser a mailbox MS_GRAPH_SENDER (ex.: Suporte@nxs.pt).
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_SENDER=

# ---- Integração ERP (sync read-only) ----
# driver: vazio (inativo) | fake (dados de teste) | sqlsrv (views read-only do ERP)
ERP_DRIVER=
ERP_DB_HOST=
ERP_DB_PORT=1433
ERP_DB_DATABASE=
ERP_DB_USERNAME=
ERP_DB_PASSWORD=
# Timeout (segundos) das queries ao ERP — um PHC lento aborta em vez de pendurar o sync.
ERP_DB_TIMEOUT=30
# Nota: o sync corre 3x/dia (08h/13h/19h) — agendado em routes/console.php, não via env.
ERP_SYNC_HORA="03:00"

VITE_APP_NAME="${APP_NAME}"
